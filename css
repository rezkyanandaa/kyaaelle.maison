:root {
  --pink: #e7b6c1;
  --pink-dark: #bd8795;
  --pink-soft: #f5e4e4;
  --ivory: #fffaf5;
  --white: #ffffff;
  --text: #403438;
  --muted: #88777b;
  --border: #eee3e1;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "DM Sans", sans-serif;
  background: var(--ivory);
  color: var(--text);
  overflow-x: hidden;
}

body,
a,
button {
  cursor: none;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
select,
input {
  font-family: inherit;
}

button {
  border: 0;
  background: none;
}

.announcement {
  height: 32px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--pink-soft);
  color: #8f6c75;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
}


/* HEADER */

.header {
  height: 78px;
  padding: 0 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255,250,245,.9);
  backdrop-filter: blur(18px);
}

.logo {
  font-family: "Playfair Display", serif;
  font-size: 25px;
  font-weight: 500;
}

.logo span,
.footer-logo span {
  font-family: "DM Sans", sans-serif;
  font-size: 11px;
  color: var(--pink-dark);
}

.desktop-nav {
  display: flex;
  gap: 34px;
}

.desktop-nav a {
  font-size: 12px;
  color: #625358;
  position: relative;
}

.desktop-nav a::after {
  content: "";
  position: absolute;
  width: 0;
  height: 1px;
  bottom: -5px;
  left: 0;
  background: var(--pink-dark);
  transition: .3s;
}

.desktop-nav a:hover::after {
  width: 100%;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 17px;
}

#languageSelector {
  border: 0;
  background: transparent;
  font-size: 11px;
  color: #66555a;
  outline: none;
}

.icon-btn {
  width: 30px;
  height: 30px;
  position: relative;
  font-size: 20px;
  color: #4b3d41;
}

.cart-count {
  position: absolute;
  top: -4px;
  right: -5px;
  width: 14px;
  height: 14px;
  display: grid;
  place-items: center;
  background: var(--pink);
  color: white;
  border-radius: 50%;
  font-size: 8px;
}

.menu-btn {
  display: none;
  font-size: 22px;
}


/* MOBILE NAV */

.mobile-nav {
  display: none;
}


/* SEARCH */

.search-panel {
  position: fixed;
  inset: 0;
  background: rgba(255,250,245,.98);
  z-index: 100;
  transform: translateY(-100%);
  transition: .45s ease;
}

.search-panel.open {
  transform: translateY(0);
}

.search-inner {
  max-width: 900px;
  margin: auto;
  padding: 100px 30px;
}

.search-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}

.search-top p {
  font-family: "Playfair Display", serif;
  font-size: 28px;
}

.search-top button {
  font-size: 30px;
}

#searchInput {
  width: 100%;
  border: 0;
  border-bottom: 1px solid #cdbfc0;
  padding: 18px 0;
  outline: 0;
  background: transparent;
  font-size: 18px;
  color: var(--text);
}

#searchResults {
  display: grid;
  gap: 12px;
  margin-top: 25px;
}

.search-result {
  display: flex;
  justify-content: space-between;
  padding: 15px;
  border-bottom: 1px solid var(--border);
}


/* HERO */

.hero {
  min-height: calc(100vh - 110px);
  padding: 7vw 8vw;
  display: grid;
  grid-template-columns: .9fr 1fr;
  align-items: center;
  gap: 7vw;
}

.hero-content {
  max-width: 570px;
}

.eyebrow {
  font-size: 10px;
  letter-spacing: .22em;
  color: var(--pink-dark);
  font-weight: 600;
  margin-bottom: 20px;
}

.hero h1 {
  font-family: "Playfair Display", serif;
  font-weight: 500;
  font-size: clamp(3.5rem, 6vw, 6.5rem);
  line-height: .93;
}

.hero h1 em,
.section-heading h2 em,
.promo h2 em,
.about h2 em {
  color: var(--pink-dark);
  font-style: italic;
}

.hero-description {
  max-width: 470px;
  margin: 28px 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
}

.hero-buttons {
  display: flex;
  gap: 25px;
  align-items: center;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  padding: 14px 22px;
  border-radius: 100px;
  background: var(--pink);
  color: white;
  font-size: 11px;
  font-weight: 600;
  transition: .3s;
}

.primary-btn:hover {
  background: var(--pink-dark);
  transform: translateY(-3px);
}

.secondary-btn {
  font-size: 11px;
  border-bottom: 1px solid #8d7b80;
  padding-bottom: 4px;
}


/* SLIDER */

.hero-slider {
  width: min(100%, 590px);
  justify-self: end;
}

.slides {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 220px 220px 12px 12px;
  background: #eee0dc;
}

.slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: scale(1.03);
  transition: opacity .8s ease, transform 1s ease;
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}

.slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slide-label {
  position: absolute;
  bottom: 20px;
  left: 24px;
  right: 24px;
  display: flex;
  justify-content: space-between;
  color: white;
  font-size: 10px;
  letter-spacing: .14em;
  text-transform: uppercase;
  text-shadow: 0 1px 8px rgba(0,0,0,.3);
}

.slider-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 15px;
}

.slider-controls button {
  font-size: 17px;
  color: #67555a;
}

.slider-dots {
  display: flex;
  gap: 6px;
}

.slider-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d9c9ca;
}

.slider-dot.active {
  background: var(--pink-dark);
}


/* MARQUEE */

.marquee {
  overflow: hidden;
  padding: 23px 0;
  background: var(--pink-soft);
}

.marquee-track {
  width: max-content;
  display: flex;
  align-items: center;
  gap: 27px;
  animation: marquee 25s linear infinite;
}

.marquee span {
  font-size: 10px;
  letter-spacing: .25em;
  color: #906f77;
}

.marquee i {
  color: var(--pink-dark);
}

@keyframes marquee {
  to {
    transform: translateX(-50%);
  }
}


/* COLLECTION */

.collection {
  padding: 110px 7vw;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 50px;
  margin-bottom: 42px;
}

.section-heading h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: .95;
  font-weight: 500;
}

.section-heading > p {
  max-width: 330px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}


/* FILTER */

.filters {
  display: flex;
  gap: 12px;
  margin-bottom: 35px;
  flex-wrap: wrap;
}

.filter {
  border: 1px solid #ded1d0;
  padding: 9px 18px;
  border-radius: 50px;
  font-size: 10px;
  color: #78686c;
  transition: .3s;
}

.filter:hover,
.filter.active {
  background: var(--text);
  color: white;
  border-color: var(--text);
}


/* PRODUCTS */

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 42px 20px;
}

.product {
  transition: .3s;
}

.product-image {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 110px 110px 8px 8px;
  background: #eee3df;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: .7s;
}

.product:hover .product-image img {
  transform: scale(1.05);
}

.product-tag {
  position: absolute;
  z-index: 3;
  top: 14px;
  left: 14px;
  padding: 7px 10px;
  background: white;
  border-radius: 30px;
  font-size: 8px;
  letter-spacing: .1em;
}

.add-cart {
  position: absolute;
  bottom: 15px;
  left: 50%;
  transform: translate(-50%, 20px);
  opacity: 0;
  padding: 11px 20px;
  background: white;
  color: var(--text);
  border-radius: 50px;
  font-size: 10px;
  transition: .3s;
  box-shadow: 0 8px 30px rgba(0,0,0,.08);
}

.product:hover .add-cart {
  opacity: 1;
  transform: translate(-50%, 0);
}

.product-category {
  margin-top: 13px;
  color: var(--pink-dark);
  font-size: 8px;
  letter-spacing: .18em;
}

.product h3 {
  margin-top: 5px;
  font-family: "Playfair Display", serif;
  font-size: 17px;
  font-weight: 500;
}

.product strong {
  display: block;
  margin-top: 6px;
  font-size: 11px;
  font-weight: 500;
}


/* PROMO */

.promo {
  margin: 20px 7vw 100px;
  padding: 90px 8vw;
  background: #f4dfdf;
  position: relative;
  overflow: hidden;
}

.promo-content {
  position: relative;
  z-index: 2;
}

.promo h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(3rem, 5vw, 5.5rem);
  line-height: .95;
  font-weight: 500;
}

.promo p:not(.eyebrow) {
  max-width: 410px;
  margin: 25px 0;
  color: #806e73;
  line-height: 1.8;
  font-size: 13px;
}

.promo-decoration {
  position: absolute;
  right: 8%;
  top: 20%;
  font-family: "Playfair Display", serif;
  font-size: 220px;
  color: rgba(255,255,255,.6);
}


/* ABOUT */

.about {
  padding: 110px 20px;
  text-align: center;
}

.about h2 {
  font-family: "Playfair Display", serif;
  font-size: clamp(2.8rem, 5vw, 5rem);
  font-weight: 500;
  line-height: 1;
}

.about-text {
  max-width: 620px;
  margin: 30px auto;
  color: var(--muted);
  line-height: 1.9;
  font-size: 13px;
}


/* CART */

.cart-overlay {
  position: fixed;
  inset: 0;
  background: rgba(40,25,30,.2);
  z-index: 70;
  opacity: 0;
  pointer-events: none;
  transition: .3s;
}

.cart-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.cart-drawer {
  position: fixed;
  right: 0;
  top: 0;
  width: min(430px, 100%);
  height: 100vh;
  background: var(--ivory);
  z-index: 80;
  transform: translateX(100%);
  transition: .45s ease;
  padding: 30px;
  display: flex;
  flex-direction: column;
}

.cart-drawer.open {
  transform: translateX(0);
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--border);
}

.cart-header h2 {
  font-family: "Playfair Display", serif;
  font-size: 28px;
  font-weight: 500;
}

.cart-header button {
  font-size: 28px;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 25px 0;
}

.empty-cart {
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  margin-top: 70px;
}

.cart-item {
  display: grid;
  grid-template-columns: 65px 1fr auto;
  gap: 13px;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.cart-item img {
  width: 65px;
  height: 75px;
  object-fit: cover;
  border-radius: 40px 40px 5px 5px;
}

.cart-item h4 {
  font-family: "Playfair Display", serif;
  font-size: 14px;
  font-weight: 500;
}

.cart-item p {
  font-size: 10px;
  margin-top: 4px;
  color: var(--muted);
}

.remove-item {
  font-size: 18px;
  color: #9d7c84;
}

.cart-footer {
  border-top: 1px solid var(--border);
  padding-top: 20px;
}

.cart-total {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18px;
  font-size: 12px;
}

.checkout-btn {
  display: block;
  text-align: center;
  padding: 15px;
  background: var(--text);
  color: white;
  border-radius: 50px;
  font-size: 11px;
}


/* WHATSAPP */

.whatsapp {
  position: fixed;
  right: 24px;
  bottom: 24px;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #dcaab7;
  color: white;
  display: grid;
  place-items: center;
  z-index: 60;
  box-shadow: 0 12px 35px rgba(110,70,80,.22);
  transition: .3s;
}

.whatsapp:hover {
  transform: translateY(-5px) scale(1.05);
}

.wa-icon {
  font-size: 25px;
}

.wa-tooltip {
  position: absolute;
  right: 70px;
  white-space: nowrap;
  background: white;
  color: #604f54;
  padding: 9px 14px;
  border-radius: 30px;
  font-size: 10px;
  box-shadow: 0 8px 25px rgba(0,0,0,.08);
  opacity: 0;
  transform: translateX(8px);
  pointer-events: none;
  transition: .3s;
}

.whatsapp:hover .wa-tooltip {
  opacity: 1;
  transform: translateX(0);
}


/* CURSOR */

.cursor-dot {
  width: 6px;
  height: 6px;
  position: fixed;
  border-radius: 50%;
  background: var(--pink-dark);
  pointer-events: none;
  z-index: 200;
  transform: translate(-50%, -50%);
}

.cursor-ring {
  width: 30px;
  height: 30px;
  position: fixed;
  border: 1px solid var(--pink-dark);
  border-radius: 50%;
  pointer-events: none;
  z-index: 199;
  transform: translate(-50%, -50%);
  transition:
    width .25s,
    height .25s,
    background .25s;
}

.cursor-ring.active {
  width: 48px;
  height: 48px;
  background: rgba(231,182,193,.12);
}


/* FOOTER */

footer {
  padding: 55px 7vw 30px;
  border-top: 1px solid var(--border);
  text-align: center;
}

.footer-logo {
  font-family: "Playfair Display", serif;
  font-size: 25px;
}

footer > p {
  margin: 10px 0 25px;
  color: var(--muted);
  font-size: 11px;
}

.footer-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 25px;
}

.footer-links a {
  font-size: 10px;
}

footer small {
  color: #a79599;
  font-size: 9px;
}


/* RESPONSIVE */

@media (max-width: 900px) {

  .desktop-nav {
    display: none;
  }

  .menu-btn {
    display: block;
  }

  .mobile-nav {
    position: fixed;
    top: 110px;
    left: 0;
    width: 100%;
    padding: 25px;
    background: var(--ivory);
    z-index: 45;
    display: none;
    flex-direction: column;
    gap: 20px;
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav.open {
    display: flex;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 65px;
  }

  .hero-slider {
    justify-self: center;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .section-heading {
    display: block;
  }

  .section-heading > p {
    margin-top: 25px;
  }
}


@media (max-width: 550px) {

  body,
  a,
  button {
    cursor: auto;
  }

  .cursor-dot,
  .cursor-ring {
    display: none;
  }

  .header {
    height: 70px;
    padding: 0 5vw;
  }

  .header-actions {
    gap: 8px;
  }

  .hero {
    padding: 55px 6vw;
  }

  .hero h1 {
    font-size: 3.5rem;
  }

  .hero-slider {
    width: 100%;
  }

  .slides {
    border-radius: 140px 140px 10px 10px;
  }

  .collection {
    padding: 75px 5vw;
  }

  .product-grid {
    gap: 35px 12px;
  }

  .product-image {
    border-radius: 70px 70px 7px 7px;
  }

  .product h3 {
    font-size: 15px;
  }

  .promo {
    margin: 10px 5vw 70px;
    padding: 70px 30px;
  }

  .promo-decoration {
    font-size: 130px;
    right: 0;
  }

  .about {
    padding: 80px 20px;
  }

  .whatsapp {
    right: 18px;
    bottom: 18px;
  }
}

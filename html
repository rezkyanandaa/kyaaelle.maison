      <a href="#collection" data-id="collection">Collection</a>
      <a href="#promo" data-id="promo">Promo</a>
      <a href="#about" data-id="about">About</a>
    </nav>

    <div class="header-actions">

      <!-- LANGUAGE -->
      <select id="languageSelector" aria-label="Language">
        <option value="id">ID</option>
        <option value="en">EN</option>
      </select>

      <!-- SEARCH -->
      <button class="icon-btn" id="searchBtn" aria-label="Search">
        ⌕
      </button>

      <!-- CART -->
      <button class="icon-btn cart-button" id="cartBtn" aria-label="Cart">
        ♡
        <span class="cart-count">0</span>
      </button>

      <!-- MOBILE MENU -->

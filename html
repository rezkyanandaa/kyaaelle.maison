      <h2>
        Your bag
      </h2>

      <button id="closeCart">
        ×
      </button>

    </div>

    <div class="cart-items" id="cartItems">

      <p class="empty-cart">
        Your bag is currently empty ♡
      </p>

    </div>

    <div class="cart-footer">

      <div class="cart-total">

        <span>
